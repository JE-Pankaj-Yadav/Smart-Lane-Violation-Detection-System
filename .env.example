# Application
SECRET_KEY=replace-with-a-long-random-secret
PORT=5000
# Flask listens on this port inside Docker; map host:5000 to container:5000.
LOG_LEVEL=INFO

# Directories (relative to project root)
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
TEMP_DIR=temp
LOG_DIR=logs

# Processing
DEVICE=auto
CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.45
INFERENCE_SIZE=640
FRAME_INTERVAL=1

# FFmpeg: leave empty to use PATH
FFMPEG_PATH=
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23

# Optional e-mail alerts
ALERT_EMAIL_ENABLED=false
EMAIL_SENDER=
EMAIL_RECIPIENT=
SENDER_PASSWORD=
EMAIL_COOLDOWN_SECONDS=600
